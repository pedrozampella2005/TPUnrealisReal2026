# Unreal Engine project .gitignore

# Build artifacts
Binaries/
Build/

# Cache and temporary files
DerivedDataCache/
Intermediate/
Saved/

# Logs and temp files
*.log
*.tmp

# User-specific files
*.user
*.suo
*.userprefs
*.o
*.obj
*.pdb
*.exe
*.dll
*.lib

# Backup files
*.bak
*.swp

# Visual Studio Code
.vscode/

# JetBrains IDE
.idea/

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
